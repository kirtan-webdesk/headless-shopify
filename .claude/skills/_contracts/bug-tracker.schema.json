{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webdesksolution.ca/schemas/bug-tracker.schema.json",
  "title": "QA Bug Tracker",
  "description": "Bug lifecycle schema per v1.5.2 — addresses Kitchen Blockers retro requirement for structured bug tracking. Lifecycle: LOGGED → FIXED → RETESTING → VERIFIED → CLOSED. One file per project: /projects/[client]/qa-reports/bugs.json",
  "type": "object",
  "required": ["schema_version", "project", "bugs"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "project": {
      "type": "string",
      "description": "Client slug or project ID"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "stats": {
      "type": "object",
      "description": "Roll-up counts for dashboards (recomputed on every write)",
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "by_status": {
          "type": "object",
          "properties": {
            "LOGGED": {"type": "integer", "minimum": 0},
            "FIXED": {"type": "integer", "minimum": 0},
            "RETESTING": {"type": "integer", "minimum": 0},
            "VERIFIED": {"type": "integer", "minimum": 0},
            "CLOSED": {"type": "integer", "minimum": 0},
            "WONT_FIX": {"type": "integer", "minimum": 0},
            "DUPLICATE": {"type": "integer", "minimum": 0}
          }
        },
        "by_severity": {
          "type": "object",
          "properties": {
            "P1": {"type": "integer", "minimum": 0},
            "P2": {"type": "integer", "minimum": 0},
            "P3": {"type": "integer", "minimum": 0},
            "P4": {"type": "integer", "minimum": 0}
          }
        },
        "open_by_severity": {
          "type": "object",
          "description": "Count of bugs not in CLOSED, WONT_FIX, or DUPLICATE",
          "properties": {
            "P1": {"type": "integer", "minimum": 0},
            "P2": {"type": "integer", "minimum": 0},
            "P3": {"type": "integer", "minimum": 0},
            "P4": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "bugs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bug"
      }
    }
  },
  "$defs": {
    "bug": {
      "type": "object",
      "required": ["id", "title", "severity", "status", "logged_by", "logged_at"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BUG-[0-9]{4,}$",
          "description": "Sequential ID, e.g. BUG-0001"
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "description": "Markdown allowed. Repro steps, expected vs actual."
        },
        "severity": {
          "type": "string",
          "enum": ["P1", "P2", "P3", "P4"],
          "description": "P1=critical (blocks launch), P2=significant, P3=polish, P4=nice-to-have"
        },
        "status": {
          "type": "string",
          "enum": ["LOGGED", "FIXED", "RETESTING", "VERIFIED", "CLOSED", "WONT_FIX", "DUPLICATE"],
          "description": "Lifecycle: LOGGED → FIXED → RETESTING → VERIFIED → CLOSED. WONT_FIX and DUPLICATE are terminal alternatives."
        },
        "category": {
          "type": "string",
          "enum": ["functional", "visual", "performance", "accessibility", "seo", "security", "content", "integration", "responsive", "browser-compat", "other"]
        },
        "affected_paths": {
          "type": "array",
          "items": {"type": "string"},
          "description": "File paths or URLs affected"
        },
        "affected_browsers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "browser": {"type": "string"},
              "version": {"type": "string"},
              "platform": {"type": "string"}
            }
          }
        },
        "affected_viewports": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["mobile-375", "mobile-414", "tablet-768", "desktop-1280", "desktop-1920"]
          }
        },
        "screenshots": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Relative paths to screenshot files"
        },
        "repro_steps": {
          "type": "array",
          "items": {"type": "string"}
        },
        "expected": {"type": "string"},
        "actual": {"type": "string"},
        "logged_by": {"type": "string"},
        "logged_at": {"type": "string", "format": "date-time"},
        "assigned_to": {"type": "string"},
        "fixed_by": {"type": "string"},
        "fixed_at": {"type": "string", "format": "date-time"},
        "fix_commit_sha": {"type": "string"},
        "fix_pr_url": {"type": "string"},
        "retest_by": {"type": "string"},
        "retest_started_at": {"type": "string", "format": "date-time"},
        "verified_by": {"type": "string"},
        "verified_at": {"type": "string", "format": "date-time"},
        "closed_at": {"type": "string", "format": "date-time"},
        "milestone": {
          "type": "string",
          "description": "Which milestone this bug surfaced in (M1, M2, M3, M4, M5)"
        },
        "sprint": {
          "type": "string",
          "description": "Which sprint surfaced the bug"
        },
        "found_at_gate": {
          "type": "string",
          "enum": ["G2", "G3", "G4", "G5", "G6", "post-launch"],
          "description": "Which gate / phase caught the bug"
        },
        "kb_candidate": {
          "type": "boolean",
          "description": "If true, this bug pattern should feed K4 feedback loop into forbidden.md"
        },
        "kb_candidate_notes": {
          "type": "string",
          "description": "Why this is a KB candidate, what rule it might inform"
        },
        "duplicate_of": {
          "type": "string",
          "pattern": "^BUG-[0-9]{4,}$",
          "description": "If status is DUPLICATE, the canonical bug ID"
        },
        "wont_fix_reason": {
          "type": "string",
          "description": "Required if status is WONT_FIX. Rationale for not fixing."
        },
        "history": {
          "type": "array",
          "description": "Status transition history",
          "items": {
            "type": "object",
            "required": ["from_status", "to_status", "transitioned_by", "transitioned_at"],
            "properties": {
              "from_status": {"type": "string"},
              "to_status": {"type": "string"},
              "transitioned_by": {"type": "string"},
              "transitioned_at": {"type": "string", "format": "date-time"},
              "notes": {"type": "string"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "FIXED"}}},
          "then": {"required": ["fixed_by", "fixed_at"]}
        },
        {
          "if": {"properties": {"status": {"const": "VERIFIED"}}},
          "then": {"required": ["verified_by", "verified_at", "fixed_by", "fixed_at"]}
        },
        {
          "if": {"properties": {"status": {"const": "CLOSED"}}},
          "then": {"required": ["verified_by", "verified_at", "closed_at"]}
        },
        {
          "if": {"properties": {"status": {"const": "WONT_FIX"}}},
          "then": {"required": ["wont_fix_reason"]}
        },
        {
          "if": {"properties": {"status": {"const": "DUPLICATE"}}},
          "then": {"required": ["duplicate_of"]}
        }
      ]
    }
  }
}
