{
  "$schema": "./node_modules/@lhci/cli/lib/json-schemas/lhci-config-schema.json",
  "_comment_": "Lighthouse CI baseline config. Per shopify/knowledge/04-performance-budget.md",

  "ci": {
    "collect": {
      "_comment_collect": "Override URLs in CI workflow per project's preview URL",
      "url": [
        "https://example.myshopify.com/?preview_theme_id=000000",
        "https://example.myshopify.com/products/example?preview_theme_id=000000",
        "https://example.myshopify.com/collections/all?preview_theme_id=000000",
        "https://example.myshopify.com/cart?preview_theme_id=000000"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "mobile",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "requestLatencyMs": 0,
          "downloadThroughputKbps": 0,
          "uploadThroughputKbps": 0,
          "cpuSlowdownMultiplier": 4
        },
        "screenEmulation": {
          "mobile": true,
          "width": 360,
          "height": 640,
          "deviceScaleFactor": 2.625,
          "disabled": false
        }
      }
    },
    "_comment_thresholds_normal": "Thresholds for normal Shopify projects (Option A per I2). Headless projects use stricter values.",
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["warn", {"minScore": 0.80}],
        "categories:accessibility": ["error", {"minScore": 0.95}],
        "categories:seo": ["warn", {"minScore": 0.95}],
        "categories:best-practices": ["warn", {"minScore": 0.90}],

        "largest-contentful-paint": ["warn", {"maxNumericValue": 3000}],
        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.05}],
        "interactive": ["warn", {"maxNumericValue": 5000}],
        "total-blocking-time": ["warn", {"maxNumericValue": 200}],
        "first-contentful-paint": ["warn", {"maxNumericValue": 1800}],
        "speed-index": ["warn", {"maxNumericValue": 3500}],

        "_comment_": "Disable specific noisy audits (allow these to pass even if they would warn)",
        "uses-rel-preload": "off",
        "non-composited-animations": "off",
        "third-party-summary": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage",
      "_comment_upload": "Alternative: use Lighthouse CI server for historical tracking. Configure GitHub App for PR comments."
    }
  }
}
